rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(userEmail());
    }

    function userDocExists() {
      return exists(userDocPath());
    }

    function getUserDoc() {
      return get(userDocPath()).data;
    }

    function getUserSchoolId() {
      return userDocExists() && 'schoolId' in getUserDoc() ? getUserDoc().schoolId : null;
    }

    function hasSchool() {
      return isSignedIn() && getUserSchoolId() != null;
    }

    // -------------------------------------------------------------
    // 1. Schools Collection
    // -------------------------------------------------------------
    match /schools/{schoolId} {
      // 2. TEACHER CODE READ: A signed-in user with NO schoolId yet CAN read a SINGLE
      // schools document by its document ID (to validate a School Code) — but CANNOT list/query ALL schools.
      // Once assigned to a school, a user can only read their own school doc.
      allow get: if isSignedIn() && (
        !hasSchool() ||
        resource.data.schoolId == getUserSchoolId() ||
        schoolId == getUserSchoolId()
      );

      // Listing or querying all schools is NOT allowed (only allowed for matching schoolId if already member)
      allow list: if hasSchool() && resource.data.schoolId == getUserSchoolId();

      // 1. BOOTSTRAP EXCEPTION: A signed-in user with NO schoolId yet CAN create ONE schools document
      // (with their own UID as creator).
      allow create: if isSignedIn() && (
        !hasSchool() && (
          request.resource.data.creatorUid == request.auth.uid ||
          request.resource.data.createdBy == request.auth.uid
        )
      );

      // 3. & 5. Only school members can update/delete their own school
      allow update, delete: if hasSchool() && (
        resource.data.schoolId == getUserSchoolId() ||
        schoolId == getUserSchoolId()
      );
    }

    // -------------------------------------------------------------
    // 2. Users Collection
    // -------------------------------------------------------------
    match /users/{userEmailDoc} {
      // 4. OWN PROFILE: Every signed-in user can ALWAYS read their OWN users document.
      // Colleagues in the same school can also read user profiles in their school.
      allow get: if isSignedIn() && (
        userEmailDoc.lower() == userEmail() ||
        (hasSchool() && resource.data.schoolId == getUserSchoolId())
      );

      allow list: if hasSchool() && resource.data.schoolId == getUserSchoolId();

      // 1. BOOTSTRAP EXCEPTION: A signed-in user can create their OWN users document
      // (keyed by their lowercased email).
      allow create: if isSignedIn() && (
        userEmailDoc.lower() == userEmail() &&
        request.resource.data.email.lower() == userEmail()
      );

      // Users can update their own profile, or admins can update user profiles in the same school
      allow update: if isSignedIn() && (
        userEmailDoc.lower() == userEmail() ||
        (hasSchool() && resource.data.schoolId == getUserSchoolId() && request.resource.data.schoolId == getUserSchoolId())
      );

      allow delete: if isSignedIn() && (
        userEmailDoc.lower() == userEmail() ||
        (hasSchool() && resource.data.schoolId == getUserSchoolId())
      );
    }

    // -------------------------------------------------------------
    // 3. Tenant-Isolated Data Collections
    // (students, attendance, marks, tests, dispatches, ptms, calls)
    // -------------------------------------------------------------
    // 3. CREATE vs READ: On CREATE, check request.resource.data.schoolId;
    // on READ/UPDATE/DELETE, check resource.data.schoolId matches caller's schoolId.
    // 5. School A can NEVER read/write School B's data.

    match /students/{docId} {
      allow read, delete: if hasSchool() && resource.data.schoolId == getUserSchoolId();
      allow create: if hasSchool() && request.resource.data.schoolId == getUserSchoolId();
      allow update: if hasSchool() && resource.data.schoolId == getUserSchoolId() && request.resource.data.schoolId == getUserSchoolId();
    }

    match /attendance/{docId} {
      allow read, delete: if hasSchool() && resource.data.schoolId == getUserSchoolId();
      allow create: if hasSchool() && request.resource.data.schoolId == getUserSchoolId();
      allow update: if hasSchool() && resource.data.schoolId == getUserSchoolId() && request.resource.data.schoolId == getUserSchoolId();
    }

    match /marks/{docId} {
      allow read, delete: if hasSchool() && resource.data.schoolId == getUserSchoolId();
      allow create: if hasSchool() && request.resource.data.schoolId == getUserSchoolId();
      allow update: if hasSchool() && resource.data.schoolId == getUserSchoolId() && request.resource.data.schoolId == getUserSchoolId();
    }

    match /tests/{docId} {
      allow read, delete: if hasSchool() && resource.data.schoolId == getUserSchoolId();
      allow create: if hasSchool() && request.resource.data.schoolId == getUserSchoolId();
      allow update: if hasSchool() && resource.data.schoolId == getUserSchoolId() && request.resource.data.schoolId == getUserSchoolId();
    }

    match /dispatches/{docId} {
      allow read, delete: if hasSchool() && resource.data.schoolId == getUserSchoolId();
      allow create: if hasSchool() && request.resource.data.schoolId == getUserSchoolId();
      allow update: if hasSchool() && resource.data.schoolId == getUserSchoolId() && request.resource.data.schoolId == getUserSchoolId();
    }

    match /ptms/{docId} {
      allow read, delete: if hasSchool() && resource.data.schoolId == getUserSchoolId();
      allow create: if hasSchool() && request.resource.data.schoolId == getUserSchoolId();
      allow update: if hasSchool() && resource.data.schoolId == getUserSchoolId() && request.resource.data.schoolId == getUserSchoolId();
    }

    match /calls/{docId} {
      allow read, delete: if hasSchool() && resource.data.schoolId == getUserSchoolId();
      allow create: if hasSchool() && request.resource.data.schoolId == getUserSchoolId();
      allow update: if hasSchool() && resource.data.schoolId == getUserSchoolId() && request.resource.data.schoolId == getUserSchoolId();
    }

    match /settings/{docId} {
      allow read, write: if isSignedIn() && hasSchool() && (
        !('schoolId' in resource.data) || resource.data.schoolId == getUserSchoolId()
      );
    }
  }
}
